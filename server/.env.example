# Mẫu cấu hình scs-server. Chép thành .env rồi điền giá trị thật:
#   cp .env.example .env && chmod 600 .env
# KHÔNG commit file .env (đã có trong .gitignore).
#
# Mật khẩu có dấu cách hoặc " #" thì đặt trong ngoặc kép: "abc #123".
# Biến đã đặt sẵn trong môi trường (systemd, shell) sẽ thắng giá trị trong file này.

# ---- Chung ----
SCS_ENV=dev                 # dev | prod (prod bắt buộc TLS, CA của agent, mật khẩu DB)
SCS_LOG_LEVEL=info          # debug | info | warn | error

# Cổng agent thiếu TLS hoặc CA (chưa có PKI) thì server KHÔNG chạy khi nghe ra ngoài,
# trừ khi bật rõ dòng này. Chỉ bật để thử nghiệm trên mạng tin cậy; prod cấm bật.
# Không bật thì vẫn thử được trên chính máy server: SCS_INGEST_LISTEN=127.0.0.1:6222
SCS_DEV_INSECURE=0

# ---- Cổng lắng nghe ----
# Cổng duy nhất agent cần: đăng ký, heartbeat, log, rule, cập nhật. Mở cổng này trên firewall cho các cửa hàng.
# Lưu ý: 6222 cũng là cổng cluster mặc định của NATS; chạy NATS cluster cùng máy thì đổi cổng cluster NATS.
SCS_INGEST_LISTEN=:6222
# Giới hạn kết nối đang mở trên cổng agent (chống mở hàng loạt kết nối để chiếm RAM).
# Kết nối vượt giới hạn bị đóng trước khi bắt tay TLS. Theo IP phải đủ cho một cửa hàng
# nhiều máy sau cùng IP WAN. Khi chạy systemd đặt LimitNOFILE lớn hơn SCS_INGEST_MAX_CONNS.
SCS_INGEST_MAX_CONNS=40000
SCS_INGEST_MAX_CONNS_PER_IP=64
# Web HTTPS để xác nhận máy và theo dõi. Luôn chạy HTTPS (dev chưa có chứng chỉ thì tự ký).
SCS_ADMIN_LISTEN=:7222
# Chỉ VPN hoặc chính máy server được vào web quản trị. Kết nối từ IP khác bị đóng ngay.
# Liệt kê dải IP cách nhau bằng dấu phẩy, ví dụ:
#   127.0.0.0/8,::1,10.8.0.0/24      (thêm dải VPN công ty, OpenVPN/WireGuard)
#   127.0.0.0/8,::1,100.64.0.0/10    (thêm Tailscale)
SCS_ADMIN_ALLOW=127.0.0.0/8,::1
# Các địa chỉ agent dùng gọi server, theo thứ tự ưu tiên, cách nhau dấu phẩy (menu mục 3/7 tự ghi).
# Server gửi cho agent đã duyệt; agent tự chuyển sang địa chỉ kế tiếp khi địa chỉ đang dùng mất kết nối.
# Ví dụ: https://192.168.1.10:6222,https://ten.ddns.net:16222
SCS_AGENT_SERVERS=
# File danh sách địa chỉ trên. Chưa có file thì server tạo từ SCS_AGENT_SERVERS; có rồi thì FILE THẮNG.
# Sửa lúc đang chạy, không khởi động lại: web trang "Địa chỉ server", menu mục 15, hoặc
# scs-server servers list|add|remove|set. install.sh ghi thành đường dẫn tuyệt đối.
SCS_AGENT_SERVERS_FILE=data/agent-servers.json

# ---- TLS (bắt buộc khi prod) ----
SCS_TLS_CERT=
SCS_TLS_KEY=
# CA dùng để kiểm chứng chỉ của agent (mTLS)
SCS_TLS_CLIENT_CA=
# CA nội bộ cấp chứng chỉ cho agent khi admin duyệt máy (bắt buộc khi prod).
# Tạo một lần bằng: scs-server pki init -ip <IP WAN của server> [-ip <IP VPN>]
# Lệnh đó tạo cả chứng chỉ server (ghi IP WAN để agent gọi thẳng bằng IP) và in sẵn các dòng cần điền.
# SCS_CA_KEY là bí mật quan trọng nhất: ai có file này cấp được chứng chỉ giả cho máy.
SCS_CA_CERT=
SCS_CA_KEY=

# ---- PostgreSQL ----
SCS_DB_HOST=127.0.0.1
SCS_DB_PORT=5432
SCS_DB_NAME=scs
SCS_DB_USER=scs
# compose.dev.yml dùng chung biến này để tạo DB. Tạo ngẫu nhiên: openssl rand -hex 24
# (đổi mật khẩu sau khi DB đã tạo thì phải xóa volume: docker compose -f compose.dev.yml down -v)
SCS_DB_PASSWORD=
SCS_DB_SSLMODE=disable      # DB ở máy khác: require hoặc verify-full

# ---- NATS ----
SCS_NATS_URL=nats://127.0.0.1:4222
SCS_NATS_USER=scs
# Bắt đầu bằng chữ cái, chỉ chữ và số (NATS đọc biến này như cú pháp config, "9ab..." bị hiểu là số): echo "s$(openssl rand -hex 24)"
SCS_NATS_PASSWORD=

# ---- Lưu trữ folder theo máy ----
SCS_STORAGE_ROOT=./data/devices

# ---- Đăng nhập web quản trị ----
# Người dùng đăng nhập bằng mã 6 số: trên máy server chạy `scs-server login-code`.
# Lệnh đó lấy mã từ server đang chạy qua Unix socket này (quyền 600, cùng user với dịch vụ).
# Thư mục chứa socket phải quyền 700 (server tự tạo nếu chưa có; có sẵn mà quyền rộng hơn thì từ chối chạy),
# nên để socket trong thư mục riêng. Khi chạy bằng systemd nên đặt: /run/scs-server/control.sock
# (unit khai RuntimeDirectory=scs-server và RuntimeDirectoryMode=0700).
SCS_CONTROL_SOCKET=data/run/control.sock

# Tùy chọn: token cho script tự động gọi API quản trị (Authorization: Bearer ..., quyền Admin).
# Giao diện web không dùng token này. Để trống nếu không cần. Tạo: openssl rand -hex 32
SCS_ADMIN_TOKEN=

# Tài khoản web quản trị đăng nhập bằng mã gửi qua email (server/README.md mục "Tài khoản và mức quyền").
# Để trống SCS_SMTP_HOST = tắt, chỉ đăng nhập bằng mã lấy qua SSH. Gmail: dùng MỘT Gmail riêng để gửi, bật xác minh
# 2 bước, tạo "Mật khẩu ứng dụng" rồi tự điền vào SCS_SMTP_PASSWORD (không dùng mật khẩu Gmail thường).
SCS_SMTP_HOST=
SCS_SMTP_PORT=587
SCS_SMTP_USER=
SCS_SMTP_PASSWORD=
SCS_SMTP_FROM=
# Tên miền email được đăng ký, cách nhau dấu phẩy; "*" = mọi tên miền.
SCS_ACCOUNT_DOMAINS=gmail.com

# Giữ lịch sử thông số server (trang Báo cáo server) bao lâu: 1 ngày – 400 ngày, mặc định 90 ngày.
# SCS_METRICS_KEEP=2160h

# Phát hành bản agent: tối đa bấy nhiêu máy tải cùng lúc (máy khác chạy bản cũ, xin lại ở heartbeat sau),
# và tổng băng thông tải bản agent + bộ rule (Mbit/s). Heartbeat, log, web không bị giới hạn.
# SCS_DOWNLOAD_SLOTS=4
# SCS_DOWNLOAD_MBPS=20

# Cụm nhiều server (docs/thiet-ke-cum-server.md). Thư mục chứa khóa node (node.key, quyền 600) và
# nhật ký quyết định (log.jsonl); cổng liên lạc giữa các server, chỉ mở khi node đã thuộc một cụm hoặc đang
# xin vào cụm (scs-server cluster init ... / cluster join ...; xem INSTALL.md mục 4). Trên server đã cài, đường dẫn tương đối tính từ /var/lib/scs-server.
SCS_CLUSTER_DIR=data/cluster
SCS_CLUSTER_LISTEN=:5222

# Kho bộ rule quét log: file nguồn .yaml (src/) và bản đã ký (signed/). Thêm, duyệt (ký) trên web
# trang "Rule quét log", menu mục 16 hoặc scs-server rules list|add|approve. Đường dẫn tương đối tính
# từ thư mục làm việc (server đã cài: /var/lib/scs-server; install.sh ghi đường dẫn tuyệt đối).
SCS_RULES_DIR=data/rules

# Lưu theo giai đoạn (docs/thiet-ke-luu-theo-giai-doan.md): cảnh báo mức high tự đóng sau bấy lâu không
# có sự kiện high / critical mới (critical chỉ admin đóng); không nghe máy gửi gì bấy lâu thì báo mất
# liên lạc (agent gọi về ngẫu nhiên 5–30 phút một lần: 60m = 2 nhịp, nên từ 60m). Dạng 24h, 90m, 60m.
SCS_ALERT_AUTOCLOSE=24h
SCS_OFFLINE_AFTER=60m
